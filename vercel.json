{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/app.py" }
  ],
  "functions": {
    "backend/app.py": {
      "excludeFiles": "{frontend/**,venv/**,.venv/**,**/__pycache__/**,**/*.pyc,**/test_*.py,**/*.log}"
    }
  }
}
